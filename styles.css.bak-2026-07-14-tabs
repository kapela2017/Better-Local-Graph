.blg-root {
  display: flex;
  flex-direction: column;
  height: 100%;
  width: 100%;
  padding: 0;
}

.blg-title {
  padding: 8px 12px 4px;
  font-weight: 600;
  font-size: var(--font-ui-small);
  color: var(--text-muted);
  flex: 0 0 auto;
}

.blg-toolbar {
  display: flex;
  gap: 8px;
  padding: 0 12px 8px;
  flex: 0 0 auto;
  flex-wrap: wrap;
}

.blg-toolbar button {
  cursor: pointer;
}

.blg-graph {
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
}
